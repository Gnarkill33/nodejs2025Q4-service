generator client {
  provider = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  login    String   @unique 
  password String
  version  Int       @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}